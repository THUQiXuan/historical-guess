# Choose codex (local Codex login) or openai (your own API).
AGENT_PROVIDER=codex

# Codex mode: no API key in this project. First run: codex login
# Explicit game default. An empty value inherits your own Codex default.
CODEX_MODEL=gpt-5.6-sol
CODEX_EFFORT=low
CODEX_SELECT_EFFORT=medium
CODEX_GUESS_EFFORT=medium
CODEX_CHAT_EFFORT=low
CODEX_SERVICE_TIER=fast
CODEX_AGENT_TIMEOUT=180

# OpenAI-compatible Chat Completions mode. Fill ONLY your local .env.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_JSON_MODE=schema
# Optional. Leave blank for providers that do not support these fields.
OPENAI_REASONING_EFFORT=
OPENAI_SELECT_EFFORT=
OPENAI_GUESS_EFFORT=
OPENAI_CHAT_EFFORT=
OPENAI_SERVICE_TIER=
